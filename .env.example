# Interview Arcade — Environment Configuration Example
# Copy this file to .env for custom local settings:
# cp .env.example .env

# Security & Session Tokens
JWT_SECRET_KEY=ia_super_secret_dev_key_change_in_production_99x
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite Default)
DATABASE_URL=sqlite:///./interview_arcade.db

# AI Evaluation Engine (Optional)
# If left blank, the platform automatically utilizes its built-in
# deterministic semantic heuristic evaluator with 100% offline reliability.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Rate Limiting Defaults
AUTH_RATE_LIMIT=10/minute
SUBMIT_RATE_LIMIT=30/minute
